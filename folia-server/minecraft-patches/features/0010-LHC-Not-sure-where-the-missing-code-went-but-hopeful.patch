+                                finalPosition.getCenter().add(0, 0.6, 0),
+                                info.deltaMovement(),
+                                yRot,
+                                info.xRot(),
+                                info.relatives(),
+                                info.postTeleportTransition(),
+                                info.cause()
+                            )
+                        );
+                    }
                 );
             });
         }
